# Environment variables — never commit secrets
# .env is tracked on purpose: it holds ONLY the six public Supabase values
# (URL, project id, publishable/anon key) the published build needs. Publish
# does not inject them. Never put secret keys in it; secrets stay in .env.*.
.env.*
!.env.example

# Local MCP server config — may contain service-role keys, never commit
.mcp.json

test-results/
playwright-report/

# Env backups / editor dumps — never commit
*.env.bak
*.env.backup
*.env.old
*.env.copy
.env*.local
.envrc
!.env.example

# Secret scan / credential dumps
gitleaks-report.json
*-secrets.json
credentials.json

# Supabase CLI cache
supabase/.temp/
