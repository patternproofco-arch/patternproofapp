  "policies": [
    {
      "cmd": "ALL",
      "permissive": "PERMISSIVE",
      "policyname": "Attorneys manage their own evidence reviews",
      "qual": "((auth.uid() = attorney_user_id) AND private.has_attorney_access(auth.uid(), client_user_id))",
      "roles": [
        "authenticated"
      ],
      "schemaname": "public",
      "tablename": "attorney_evidence_reviews",
      "with_check": "((auth.uid() = attorney_user_id) AND private.has_attorney_access(auth.uid(), client_user_id))"
    },
    {
      "cmd": "DELETE",
      "permissive": "PERMISSIVE",
      "policyname": "Attorney deletes own notes",
      "qual": "((auth.uid() = attorney_user_id) AND (EXISTS ( SELECT 1\n   FROM attorney_client_links l\n  WHERE ((l.id = attorney_incident_notes.link_id) AND (l.attorney_user_id = auth.uid()) AND (l.client_user_id = attorney_incident_notes.client_user_id) AND (l.status = 'active'::text)))))",
      "roles": [
        "authenticated"
      ],
      "schemaname": "public",
      "tablename": "attorney_incident_notes",
      "with_check": null
    },
    {
      "cmd": "SELECT",
      "permissive": "PERMISSIVE",
      "policyname": "Attorney reads own notes",
