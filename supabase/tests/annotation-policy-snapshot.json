      ],
      "schemaname": "public",
      "tablename": "attorney_incident_notes",
      "with_check": "((auth.uid() = attorney_user_id) AND (EXISTS ( SELECT 1\n   FROM attorney_client_links l\n  WHERE ((l.id = attorney_incident_notes.link_id) AND (l.attorney_user_id = auth.uid()) AND (l.client_user_id = attorney_incident_notes.client_user_id) AND (l.status = 'active'::text)))))"
    },
