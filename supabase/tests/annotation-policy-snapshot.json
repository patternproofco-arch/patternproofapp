    },
    {
      "cmd": "SELECT",
      "permissive": "PERMISSIVE",
      "policyname": "Participants read messages",
      "qual": "(EXISTS ( SELECT 1\n   FROM attorney_client_links l\n  WHERE ((l.id = attorney_messages.link_id) AND (l.status = 'active'::text) AND (l.revoked_at IS NULL) AND ((l.expires_at IS NULL) OR (l.expires_at > now())) AND ((auth.uid() = l.client_user_id) OR (auth.uid() = l.attorney_user_id)))))",
      "roles": [
        "authenticated"
      ],
      "schemaname": "public",
