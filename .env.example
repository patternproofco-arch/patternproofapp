# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Stripe (set in Lovable/Cloudflare environment variables, not here)
# VITE_PAYMENTS_CLIENT_TOKEN=

# AI
# LOVABLE_API_KEY=

# Clio OAuth (Clio Manage integration) — server-side only, names only.
# Add real values in Project Settings -> Secrets. Never prefix any of these
# with VITE_, never log them, never return them to the client.
# CLIO_CLIENT_ID=
# CLIO_CLIENT_SECRET=
# Application-level encryption key for stored Clio tokens (auto-generated).
# CLIO_TOKEN_ENC_KEY=
# Must exactly match the redirect URI registered in the Clio developer app.
CLIO_REDIRECT_URI=https://pattern-proof.tech/integrations/clio/callback
# Master switch. The Connect button stays disabled unless this is "true".
# CLIO_INTEGRATION_ENABLED=

# Shared secret for POST /api/cron/attorney-access-cutoff (the 150/165/175/180
# day attorney bar-access reconfirmation sweep). Required in production —
# there is no Cloudflare Cron Trigger wired up yet, so something external
# (or a manual call) must POST this route with header x-cron-secret on a
# daily schedule.
# CRON_SECRET=

# TEMPORARY Verifier prove-it only — force completeSurvivorOnboarding metadata
# failure AFTER terms insert so real compensate-delete runs. OFF by default.
# Hard-refused on production / Stripe live / pattern-proof.tech before any write.
# Enable briefly on a non-prod Workers/Lovable preview (set SITE_URL to that
# preview host), prove compensate-delete, then REMOVE both vars. Never a
# query/body flag. Remove this hook from code after Verifier PASS.
# ONBOARDING_FORCE_META_FAIL=
# PATTERNPROOF_FORCE_ONBOARDING_META_FAIL=
