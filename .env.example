# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Stripe (set in Lovable/Cloudflare environment variables, not here)
# VITE_PAYMENTS_CLIENT_TOKEN=

# AI
# LOVABLE_API_KEY=

# Clio OAuth (Clio Manage integration)
# Public: safe to expose in the browser bundle (client id only)
VITE_CLIO_CLIENT_ID=
# Public: fixed callback URL registered in the Clio developer app
CLIO_REDIRECT_URI=https://pattern-proof.tech/integrations/clio/callback
# Server-only: add in Project Settings -> Secrets. Never prefix with VITE_,
# never log it, and never return it to the client.
# CLIO_CLIENT_ID=
# CLIO_CLIENT_SECRET=
