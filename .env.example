# =============================================================================
# PatternProof — environment template (PLACEHOLDERS ONLY)
# =============================================================================
# Copy to `.env` locally, or set values only in the host secret store
# (Lovable / Cloudflare / CI). NEVER commit real values.
# NEVER put privileged server credentials in any VITE_* variable.
# Issue #59: treat any credential that ever lived in git history as
# compromised until rotated in the provider dashboard and confirmed live.
# =============================================================================

# --- Supabase (browser-safe / publishable only for VITE_*) -------------------
# Dashboard: Project Settings → API
# VITE_SUPABASE_PUBLISHABLE_KEY must be the publishable (anon) key only.
# Privileged Supabase server credentials: host secret store only; never VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Stripe / payments (host secret store) -----------------------------------
# Publishable/client token may be VITE_-prefixed; restricted Stripe credentials
# and webhook signing material must NOT use VITE_ and must not be committed.
# VITE_PAYMENTS_CLIENT_TOKEN=

# --- AI / Lovable gateway (host secret store; never VITE_) -------------------
# LOVABLE_API_KEY=

# --- Clio OAuth (server-side only; never VITE_) ------------------------------
# Add real values in Project Settings → Secrets. Never log or return to client.
# CLIO_CLIENT_ID=
# CLIO_CLIENT_SECRET=
# CLIO_TOKEN_ENC_KEY=
# Must exactly match the redirect URI registered in the Clio developer app.
CLIO_REDIRECT_URI=https://pattern-proof.tech/integrations/clio/callback
# Master switch. Connect button stays disabled unless this is "true".
# CLIO_INTEGRATION_ENABLED=

# --- Build / publish markers (optional; CI often sets these) -----------------
# LOVABLE_COMMIT_SHA=

# --- TEMPORARY Verifier prove-it only ----------------------------------------
# Force completeSurvivorOnboarding metadata failure AFTER terms insert so real
# compensate-delete runs. OFF by default. Hard-refused on production / Stripe
# live / pattern-proof.tech before any write. Never a query/body flag.
# ONBOARDING_FORCE_META_FAIL=
# PATTERNPROOF_FORCE_ONBOARDING_META_FAIL=
