{
  "name": "PatternProof — Private Evidence Timeline",
  "short_name": "PatternProof",
  "description": "Private evidence documentation for survivors, attorneys, and domestic violence organizations.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FAF8F4",
