{
  "id": "/signin",
  "name": "Notes",
  "short_name": "Notes",
  "description": "Private notes on this device.",
  "start_url": "/signin",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#f4f1ea",
  "theme_color": "#f4f1ea",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icons/note.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add a note",
      "short_name": "Add",
      "url": "/journal",
      "icons": [{ "src": "/icons/note.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Timeline",
      "short_name": "Timeline",
      "url": "/timeline",
      "icons": [{ "src": "/icons/note.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Files",
      "short_name": "Files",
      "url": "/evidence",
      "icons": [{ "src": "/icons/note.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
