{
  "name": "PatternProof",
  "short_name": "PatternProof",
  "description": "Evidence documentation",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F7F5F0",
  "theme_color": "#F7F5F0",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
